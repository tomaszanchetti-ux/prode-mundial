rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todos los accesos a la DB pasan por el API Express con Admin SDK,
    // que bypassa rules. El cliente web NO habla con Firestore directo.
    // Deny-all cierra el vector de ataque client-side.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
