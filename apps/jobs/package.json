{
  "name": "@prode/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "echo \"No formatter configured for @prode/jobs yet\"",
    "sync:matches": "JOB_NAME=match-result-sync tsx src/index.ts"
  },
  "dependencies": {
    "@prode/shared": "workspace:*",
    "dotenv": "^17.4.1",
    "firebase-admin": "^13.7.0"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}
