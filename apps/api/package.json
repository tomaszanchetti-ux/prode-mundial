{
  "name": "@prode/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "echo \"No formatter configured for @prode/api yet\"",
    "seed:wc2026": "tsx src/domains/matches/scripts/seed-world-cup-2026.ts",
    "ensure:wc2026": "tsx src/domains/matches/scripts/ensure-world-cup-2026-base-data.ts",
    "seed:competition-demo": "tsx src/domains/leagues/scripts/seed-competition-demo.ts",
    "reset:competition-demo": "tsx src/domains/leagues/scripts/reset-competition-demo.ts",
    "fresh:competition-demo": "tsx src/domains/leagues/scripts/fresh-competition-demo.ts"
  },
  "dependencies": {
    "@prode/shared": "workspace:*",
    "dotenv": "^17.4.1",
    "express": "5.2.1",
    "firebase-admin": "^13.7.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsx": "4.21.0"
  }
}
