{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@prode/shared": ["packages/shared/src/index.ts"],
      "@prode/shared/*": ["packages/shared/src/*"],
      "@prode/ui": ["packages/ui/src/index.ts"],
      "@prode/config": ["packages/config/index.ts"]
    }
  }
}
